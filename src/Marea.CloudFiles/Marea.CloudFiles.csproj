<Project Sdk="Microsoft.NET.Sdk">
  <!-- Minimal interop with the Windows Cloud Files API (cldapi.dll), generated by CsWin32. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371" PrivateAssets="all" />
  </ItemGroup>
</Project>

