<Window x:Class="Marea.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Marea.App"
        Title="Marea" Width="1180" Height="780" MinWidth="900" MinHeight="600"
        Icon="pack://application:,,,/Assets/marea.ico"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation -->
        <DockPanel Grid.RowSpan="2" Background="{DynamicResource LayerFillColorDefaultBrush}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,18,22">
                <Image Source="pack://application:,,,/Assets/marea.png" Width="34" Height="34" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Marea" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{l:T app.tagline}" Style="{StaticResource Caption}" />
                </StackPanel>
            </StackPanel>
            <Border DockPanel.Dock="Bottom" Margin="14" Padding="12,10" CornerRadius="6"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ProviderDot" Width="9" Height="9" Margin="0,0,8,0" />
                        <TextBlock x:Name="ProviderText" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                    <TextBlock x:Name="ProviderDetail" Style="{StaticResource Caption}" Margin="17,2,0,0" />
                </StackPanel>
            </Border>
            <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent" Margin="8,0"
                     SelectionChanged="OnNavigate">
                <ListBoxItem Tag="overview" Padding="12,9" Content="{l:T nav.overview}" />
                <ListBoxItem Tag="files" Padding="12,9" Content="{l:T nav.files}" />
                <ListBoxItem Tag="folders" Padding="12,9" Content="{l:T nav.folders}" />
                <ListBoxItem Tag="journal" Padding="12,9" Content="{l:T nav.activity}" />
                <ListBoxItem Tag="settings" Padding="12,9" Content="{l:T nav.settings}" />
            </ListBox>
        </DockPanel>

        <ContentControl x:Name="Page" Grid.Column="1" Margin="32,26,32,12" />

        <!-- Long-running operations bar -->
        <Border x:Name="OpBar" Grid.Column="1" Grid.Row="1" Visibility="Collapsed" Padding="32,10"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="OpTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="OpDetail" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="OpProgress" Height="4" Margin="0,6,0,0" Maximum="1" />
                </StackPanel>
                <Button x:Name="OpCancel" Grid.Column="1" Content="{l:T op.cancel}" Margin="16,0,0,0" Click="OnCancel" />
            </Grid>
        </Border>
        <Border x:Name="HydBar" Grid.Column="1" Grid.Row="1" Visibility="Collapsed" Padding="32,8"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel>
                <TextBlock x:Name="HydText" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="HydProgress" Height="3" Margin="0,4,0,0" Maximum="1" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
