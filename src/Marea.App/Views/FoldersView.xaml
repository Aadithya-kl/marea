<UserControl x:Class="Marea.App.Views.FoldersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Marea.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{l:T folders.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T folders.subtitle}" Style="{StaticResource PageSubtitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button Content="{l:T folders.add}" Click="OnAdd" Margin="0,0,8,0" />
                <Button Content="{l:T folders.find}" Click="OnFind" />
            </StackPanel>
            <ItemsControl x:Name="Roots">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{l:T folders.remove}" Tag="{Binding Path}" Click="OnRemove" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
