<UserControl x:Class="Marea.App.Views.FoldersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Marea.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,0,8,12">
            <TextBlock Text="{l:T folders.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T folders.subtitle}" Style="{StaticResource PageSubtitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Style="{StaticResource AccentButtonStyle}" Click="OnFind" Margin="0,0,8,0" Padding="14,7" AutomationProperties.Name="{l:T folders.find}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.FolderSearch}" Style="{StaticResource Ico}" Margin="0,0,8,0" />
                        <TextBlock Text="{l:T folders.find}" />
                    </StackPanel>
                </Button>
                <Button Click="OnAdd" Padding="14,7" AutomationProperties.Name="{l:T folders.add}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.FolderAdd}" Style="{StaticResource Ico}" Margin="0,0,8,0" />
                        <TextBlock Text="{l:T folders.add}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <ItemsControl x:Name="Roots" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Background="{StaticResource SeaTintBrush}" Margin="0,0,16,0">
                                    <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource IcoLarge}" Fill="{StaticResource SeaAccentBrush}" />
                                </Border>
                                <Button DockPanel.Dock="Right" Tag="{Binding Path}" Click="OnRemove" VerticalAlignment="Center" Padding="12,6"
                                        AutomationProperties.Name="{l:T folders.remove}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Dismiss}" Style="{StaticResource Ico}" Margin="0,0,6,0" />
                                        <TextBlock Text="{l:T folders.remove}" />
                                    </StackPanel>
                                </Button>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="{Binding Display}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Path}" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
