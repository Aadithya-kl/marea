<Window x:Class="Marea.App.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Marea.App"
        Title="Marea" Width="760" Height="620" MinWidth="640" MinHeight="520"
        Icon="pack://application:,,,/Assets/marea.ico"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Step 1: welcome -->
        <StackPanel x:Name="Step1">
            <Image Source="pack://application:,,,/Assets/marea.png" Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,16" />
            <TextBlock Text="{l:T ob.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T ob.intro}" Style="{StaticResource PageSubtitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:T ob.point1_title}" FontWeight="SemiBold" />
                    <TextBlock Text="{l:T ob.point1}" Style="{StaticResource Caption}" Margin="0,2,0,10" />
                    <TextBlock Text="{l:T ob.point2_title}" FontWeight="SemiBold" />
                    <TextBlock Text="{l:T ob.point2}" Style="{StaticResource Caption}" Margin="0,2,0,10" />
                    <TextBlock Text="{l:T ob.point3_title}" FontWeight="SemiBold" />
                    <TextBlock Text="{l:T ob.point3}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Step 2: folders -->
        <DockPanel x:Name="Step2" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{l:T ob.folders_title}" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="FoldersSubtitle" Text="{l:T ob.searching}" Style="{StaticResource PageSubtitle}" />
                <ProgressBar x:Name="Searching" IsIndeterminate="True" Height="3" Margin="0,0,0,12" />
            </StackPanel>
            <Button DockPanel.Dock="Bottom" Content="{l:T ob.add_other}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnAddOther" />
            <ListBox x:Name="Found" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected}" Margin="0,4">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="{Binding Path}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BackButton" Content="{l:T ob.back}" Width="110" Margin="0,0,10,0" Click="OnBack" Visibility="Collapsed" />
            <Button x:Name="NextButton" Style="{StaticResource AccentButtonStyle}" Content="{l:T ob.next}" Width="170" Click="OnNext" />
        </StackPanel>
    </Grid>
</Window>
