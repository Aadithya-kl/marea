<Window x:Class="Marea.App.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Marea.App"
        Title="Marea" Width="800" Height="680" MinWidth="660" MinHeight="560"
        Icon="pack://application:,,,/Assets/marea.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="PointIcon" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="DockPanel.Dock" Value="Left" />
        </Style>
    </Window.Resources>
    <Grid Margin="36,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Step 1: welcome -->
        <StackPanel x:Name="Step1">
            <DockPanel Margin="0,0,0,20">
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/marea.png" Width="64" Height="64" Margin="0,0,18,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{l:T ob.title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{l:T ob.intro}" Style="{StaticResource Caption}" FontSize="14" />
                </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource Card}" Padding="22,18">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <Border Style="{StaticResource PointIcon}" Background="{StaticResource DuplicateBrush}">
                            <Path Data="{StaticResource Icon.Shield}" Style="{StaticResource Ico}" Width="20" Height="20" Fill="White" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{l:T ob.point1_title}" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="{l:T ob.point1}" Style="{StaticResource Caption}" FontSize="13" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,16">
                        <Border Style="{StaticResource PointIcon}" Background="{StaticResource EvaporatedBrush}">
                            <Path Data="{StaticResource Icon.Cloud}" Style="{StaticResource Ico}" Width="20" Height="20" Fill="White" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{l:T ob.point2_title}" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="{l:T ob.point2}" Style="{StaticResource Caption}" FontSize="13" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <Border Style="{StaticResource PointIcon}" Background="{StaticResource DerivableBrush}">
                            <Path Data="{StaticResource Icon.Undo}" Style="{StaticResource Ico}" Width="20" Height="20" Fill="White" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{l:T ob.point3_title}" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="{l:T ob.point3}" Style="{StaticResource Caption}" FontSize="13" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Step 2: folders -->
        <DockPanel x:Name="Step2" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Path Data="{StaticResource Icon.FolderSearch}" Style="{StaticResource IcoLarge}" Margin="0,0,10,0" />
                    <TextBlock Text="{l:T ob.folders_title}" Style="{StaticResource PageTitle}" Margin="0" />
                </StackPanel>
                <TextBlock x:Name="FoldersSubtitle" Text="{l:T ob.searching}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,12" />
                <ProgressBar x:Name="Searching" IsIndeterminate="True" Height="3" Margin="0,0,0,12" Foreground="{StaticResource SeaAccentBrush}" />
            </StackPanel>
            <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnAddOther" Padding="12,6"
                    AutomationProperties.Name="{l:T ob.add_other}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.FolderAdd}" Style="{StaticResource Ico}" Margin="0,0,8,0" />
                    <TextBlock Text="{l:T ob.add_other}" />
                </StackPanel>
            </Button>
            <ListBox x:Name="Found" BorderThickness="0" Background="Transparent">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0" Padding="14,10">
                            <CheckBox IsChecked="{Binding Selected}" VerticalContentAlignment="Center">
                                <DockPanel Margin="6,0,0,0">
                                    <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Folder}" Style="{StaticResource IcoLarge}" Fill="{StaticResource SeaAccentBrush}" Margin="0,0,12,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DockPanel>
                            </CheckBox>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock x:Name="StepText" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="{l:T ob.back}" Width="110" Margin="0,0,10,0" Click="OnBack" Visibility="Collapsed" Padding="0,8" />
                <Button x:Name="NextButton" Style="{StaticResource AccentButtonStyle}" Content="{l:T ob.next}" Width="190" Click="OnNext" Padding="0,8" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
