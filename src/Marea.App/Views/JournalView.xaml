<UserControl x:Class="Marea.App.Views.JournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Marea.App">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{l:T journal.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T journal.subtitle}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>
        <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:T col.when}" Binding="{Binding When}" Width="130" />
                <DataGridTextColumn Header="{l:T col.action}" Binding="{Binding Action}" Width="190" />
                <DataGridTextColumn Header="{l:T col.file}" Binding="{Binding File}" Width="2*" />
                <DataGridTextColumn Header="{l:T col.size}" Binding="{Binding Size}" Width="90" />
                <DataGridTextColumn Header="{l:T col.detail}" Binding="{Binding Detail}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
