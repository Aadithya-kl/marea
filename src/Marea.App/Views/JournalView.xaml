<UserControl x:Class="Marea.App.Views.JournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Marea.App">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{l:T journal.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T journal.subtitle}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>
        <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="34"
                  HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Path Data="{Binding Icon}" Style="{StaticResource Ico}" Fill="{Binding Brush}" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{l:T col.when}" Binding="{Binding When}" Width="140" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="{l:T col.action}" Binding="{Binding Action}" Width="190" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="{l:T col.file}" Binding="{Binding File}" Width="2*" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="{l:T col.size}" Binding="{Binding Size}" Width="90" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="{l:T col.detail}" Binding="{Binding Detail}" Width="3*" ElementStyle="{StaticResource CellText}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
