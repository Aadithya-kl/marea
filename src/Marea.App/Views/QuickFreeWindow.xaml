<Window x:Class="Marea.App.Views.QuickFreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Marea.App"
        Title="{l:T qf.title}" Width="760" Height="760" MinWidth="640" MinHeight="640"
        Icon="pack://application:,,,/Assets/marea.ico"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32,26">
        <!-- Step 1: choose -->
        <DockPanel x:Name="ChoosePanel">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="24" Background="{StaticResource SeaAccentBrush}" Margin="0,0,16,0">
                    <Path Data="{StaticResource Icon.Flash}" Style="{StaticResource Ico}" Width="24" Height="24" Fill="White" />
                </Border>
                <StackPanel>
                    <TextBlock Text="{l:T qf.title}" Style="{StaticResource PageTitle}" FontSize="24" />
                    <TextBlock Text="{l:T qf.subtitle}" Style="{StaticResource Caption}" FontSize="13" />
                </StackPanel>
            </DockPanel>
            <StackPanel DockPanel.Dock="Bottom">
                <Border Style="{StaticResource InfoBar}" Margin="0,8,0,16" Padding="16,12">
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Shield}" Style="{StaticResource IcoLarge}" Fill="{StaticResource SeaAccentBrush}" Margin="0,0,12,0" VerticalAlignment="Top" />
                        <TextBlock x:Name="Summary" TextWrapping="Wrap" FontSize="14" LineHeight="21" />
                    </DockPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{l:T op.cancel}" Width="120" Margin="0,0,10,0" IsCancel="True" Padding="0,8" />
                    <Button x:Name="GoButton" Width="210" Style="{StaticResource AccentButtonStyle}" Click="OnGo" Padding="0,8" IsDefault="True" AutomationProperties.Name="{l:T qf.go}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Broom}" Style="{StaticResource Ico}" Margin="0,0,8,0" />
                            <TextBlock Text="{l:T qf.go}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <TextBlock Text="{l:T qf.how_much}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                    <UniformGrid Columns="2" Margin="-4,0,-4,10">
                        <RadioButton x:Name="Amount10" GroupName="amount" Checked="OnChoice" Style="{StaticResource ChoiceCard}" Margin="4,0,4,8" Tag="{StaticResource Icon.DataPie}">
                            <StackPanel>
                                <TextBlock Text="10 GB" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock x:Name="Amount10Note" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="Amount50" GroupName="amount" Checked="OnChoice" Style="{StaticResource ChoiceCard}" Margin="4,0,4,8" Tag="{StaticResource Icon.DataPie}">
                            <StackPanel>
                                <TextBlock Text="50 GB" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock x:Name="Amount50Note" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="AmountTarget" GroupName="amount" Checked="OnChoice" Style="{StaticResource ChoiceCard}" Margin="4,0,4,8" Tag="{StaticResource Icon.Storage}">
                            <StackPanel>
                                <TextBlock Text="{l:T qf.to_target}" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock x:Name="AmountTargetNote" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="AmountAll" GroupName="amount" Checked="OnChoice" Style="{StaticResource ChoiceCard}" Margin="4,0,4,8" Tag="{StaticResource Icon.Sparkle}">
                            <StackPanel>
                                <TextBlock Text="{l:T qf.all_safe}" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock x:Name="AmountAllNote" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <TextBlock Text="{l:T qf.how_back}" Style="{StaticResource SectionTitle}" Margin="0,4,0,10" />
                    <RadioButton x:Name="ModeInstant" GroupName="mode" Checked="OnChoice" Style="{StaticResource ChoiceCard}" Tag="{StaticResource Icon.Flash}">
                        <StackPanel>
                            <TextBlock x:Name="ModeInstantTitle" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="{l:T qf.instant_help}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ModeAll" GroupName="mode" Checked="OnChoice" Style="{StaticResource ChoiceCard}" Tag="{StaticResource Icon.CloudDown}">
                        <StackPanel>
                            <TextBlock x:Name="ModeAllTitle" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="{l:T qf.download_help}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Step 2: working -->
        <StackPanel x:Name="WorkPanel" Visibility="Collapsed" VerticalAlignment="Center">
            <Path Data="{StaticResource Icon.Sync}" Style="{StaticResource Ico}" Width="44" Height="44" Fill="{StaticResource SeaAccentBrush}" HorizontalAlignment="Left" Margin="0,0,0,14" />
            <TextBlock Text="{l:T qf.working}" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="WorkDetail" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,8,0,10" />
            <ProgressBar x:Name="WorkProgress" Height="6" Maximum="1" Foreground="{StaticResource SeaAccentBrush}" />
            <Button x:Name="StopButton" Content="{l:T op.cancel}" HorizontalAlignment="Right" Width="120" Margin="0,18,0,0" Click="OnStop" />
        </StackPanel>

        <!-- Step 3: done -->
        <DockPanel x:Name="DonePanel" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ShareButton" Margin="0,0,10,0" Click="OnShare" Padding="16,8" AutomationProperties.Name="{l:T share.button}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Share}" Style="{StaticResource Ico}" Margin="0,0,8,0" />
                        <TextBlock Text="{l:T share.button}" />
                    </StackPanel>
                </Button>
                <Button x:Name="UndoButton" Width="230" Margin="0,0,10,0" Click="OnUndo" Padding="0,8" AutomationProperties.Name="{l:T qf.undo}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Undo}" Style="{StaticResource Ico}" Margin="0,0,8,0" />
                        <TextBlock Text="{l:T qf.undo}" />
                    </StackPanel>
                </Button>
                <Button Content="{l:T qf.close}" Width="140" Style="{StaticResource AccentButtonStyle}" Click="OnClose" Padding="0,8" IsDefault="True" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <Border x:Name="DoneBadge" Width="72" Height="72" CornerRadius="36" Background="{StaticResource DuplicateBrush}" HorizontalAlignment="Left" Margin="0,0,0,18">
                    <Path x:Name="DoneIcon" Data="{StaticResource Icon.Check}" Style="{StaticResource Ico}" Width="36" Height="36" Fill="White" />
                </Border>
                <TextBlock x:Name="DoneTitle" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
                <TextBlock x:Name="DoneText" Style="{StaticResource PageSubtitle}" FontSize="15" />
                <TextBlock x:Name="DoneKept" Style="{StaticResource Caption}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
