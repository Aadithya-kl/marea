<UserControl x:Class="Marea.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Marea.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{l:T set.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T set.subtitle}" Style="{StaticResource PageSubtitle}" />

            <Border x:Name="UpdateCard" Style="{StaticResource Card}" Visibility="Collapsed" BorderBrush="{StaticResource DuplicateBrush}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{l:T upd.open}" Style="{StaticResource AccentButtonStyle}" Click="OnOpenReleases" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" />
                        <TextBlock Text="{l:T upd.text}" Style="{StaticResource Caption}" Margin="0,2,12,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:T set.language}" FontWeight="SemiBold" />
                    <ComboBox x:Name="LanguageBox" Width="260" HorizontalAlignment="Left" Margin="0,6,0,0" DisplayMemberPath="Name" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:T set.tide_section}" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="AutoTide" Content="{l:T set.auto}" />
                    <TextBlock Text="{l:T set.auto_help}" Style="{StaticResource Caption}" Margin="26,2,0,12" />
                    <TextBlock Text="{l:T set.target}" />
                    <TextBox x:Name="Target" Width="120" HorizontalAlignment="Left" Margin="0,4,0,12" />
                    <TextBlock Text="{l:T set.idle}" />
                    <TextBox x:Name="Idle" Width="120" HorizontalAlignment="Left" Margin="0,4,0,12" />
                    <TextBlock Text="{l:T set.minsize}" />
                    <TextBox x:Name="MinSize" Width="120" HorizontalAlignment="Left" Margin="0,4,0,12" />
                    <TextBlock Text="{l:T set.bandwidth}" />
                    <TextBox x:Name="Bandwidth" Width="120" HorizontalAlignment="Left" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:T set.sources_section}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{l:T set.mirror}" />
                    <DockPanel Margin="0,4,0,2">
                        <Button DockPanel.Dock="Right" Content="{l:T set.pick}" Click="OnPickMirror" Margin="8,0,0,0" />
                        <TextBox x:Name="Mirror" />
                    </DockPanel>
                    <TextBlock Text="{l:T set.mirror_help}" Style="{StaticResource Caption}" Margin="0,0,0,12" />
                    <TextBlock Text="{l:T set.repos}" />
                    <TextBox x:Name="Repos" AcceptsReturn="True" Height="130" Margin="0,4,0,2"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                    <TextBlock Text="{l:T set.repos_help}" Style="{StaticResource Caption}" Margin="0,0,0,12" />
                    <CheckBox x:Name="Discover" Content="{l:T set.discover}" />
                    <TextBlock Text="{l:T set.discover_help}" Style="{StaticResource Caption}" Margin="26,2,0,10" />
                    <CheckBox x:Name="NameSearch" Content="{l:T set.name_search}" />
                    <TextBlock Text="{l:T set.name_search_help}" Style="{StaticResource Caption}" Margin="26,2,0,10" />
                    <CheckBox x:Name="Ollama" Content="{l:T set.ollama}" />
                    <TextBlock Text="{l:T set.ollama_help}" Style="{StaticResource Caption}" Margin="26,2,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="Startup" Content="{l:T set.startup}" />
                    <TextBlock Text="{l:T set.startup_help}" Style="{StaticResource Caption}" Margin="26,2,0,10" />
                    <CheckBox x:Name="Updates" Content="{l:T set.updates}" />
                    <TextBlock Text="{l:T set.updates_help}" Style="{StaticResource Caption}" Margin="26,2,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Button Content="{l:T set.save}" Width="140" Click="OnSave" />
                <TextBlock x:Name="SavedText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource SystemFillColorCriticalBrush}">
                <StackPanel>
                    <TextBlock Text="{l:T set.danger}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{l:T set.danger_help}" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                    <Button Content="{l:T set.restore_all}" HorizontalAlignment="Left" Click="OnRestoreAll" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="AboutText" Style="{StaticResource Caption}" Margin="0,4,0,20" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
