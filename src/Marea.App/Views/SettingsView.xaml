<UserControl x:Class="Marea.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Marea.App">
    <UserControl.Resources>
        <Style x:Key="Head" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Field" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="28,2,0,12" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel MaxWidth="780" HorizontalAlignment="Left" Margin="0,0,8,12">
            <TextBlock Text="{l:T set.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T set.subtitle}" Style="{StaticResource PageSubtitle}" />

            <Border x:Name="UpdateCard" Style="{StaticResource InfoBar}" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButtonStyle}" Click="OnOpenReleases" VerticalAlignment="Center" Padding="12,5"
                            AutomationProperties.Name="{l:T upd.open}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Open}" Style="{StaticResource Ico}" Margin="0,0,6,0" />
                            <TextBlock Text="{l:T upd.open}" />
                        </StackPanel>
                    </Button>
                    <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Sparkle}" Style="{StaticResource IcoLarge}" Fill="{StaticResource SeaAccentBrush}" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" />
                        <TextBlock Text="{l:T upd.text}" Style="{StaticResource Caption}" Margin="0,2,12,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- General: language and theme -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Style="{StaticResource Head}">
                        <Path Data="{StaticResource Icon.Language}" Style="{StaticResource Ico}" Margin="0,0,10,0" />
                        <TextBlock Text="{l:T set.general}" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{l:T set.language}" Style="{StaticResource Field}" />
                            <ComboBox x:Name="LanguageBox" DisplayMemberPath="Name" AutomationProperties.Name="{l:T set.language}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{l:T set.theme}" Style="{StaticResource Field}" />
                            <ComboBox x:Name="ThemeBox" DisplayMemberPath="Name" AutomationProperties.Name="{l:T set.theme}" SelectionChanged="OnThemePreview" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Tide -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Style="{StaticResource Head}">
                        <Path Data="{StaticResource Icon.Timer}" Style="{StaticResource Ico}" Margin="0,0,10,0" />
                        <TextBlock Text="{l:T set.tide_section}" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <CheckBox x:Name="AutoTide" Content="{l:T set.auto}" />
                    <TextBlock Text="{l:T set.auto_help}" Style="{StaticResource Help}" />
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,16,12">
                            <TextBlock Text="{l:T set.target}" Style="{StaticResource Field}" />
                            <TextBox x:Name="Target" AutomationProperties.Name="{l:T set.target}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{l:T set.idle}" Style="{StaticResource Field}" TextTrimming="CharacterEllipsis" />
                            <TextBox x:Name="Idle" AutomationProperties.Name="{l:T set.idle}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{l:T set.minsize}" Style="{StaticResource Field}" />
                            <TextBox x:Name="MinSize" AutomationProperties.Name="{l:T set.minsize}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{l:T set.bandwidth}" Style="{StaticResource Field}" TextTrimming="CharacterEllipsis" />
                            <TextBox x:Name="Bandwidth" AutomationProperties.Name="{l:T set.bandwidth}" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Sources -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Style="{StaticResource Head}">
                        <Path Data="{StaticResource Icon.Globe}" Style="{StaticResource Ico}" Margin="0,0,10,0" />
                        <TextBlock Text="{l:T set.sources_section}" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <CheckBox x:Name="Discover" Content="{l:T set.discover}" />
                    <TextBlock Text="{l:T set.discover_help}" Style="{StaticResource Help}" />
                    <CheckBox x:Name="NameSearch" Content="{l:T set.name_search}" />
                    <TextBlock Text="{l:T set.name_search_help}" Style="{StaticResource Help}" />
                    <CheckBox x:Name="Ollama" Content="{l:T set.ollama}" />
                    <TextBlock Text="{l:T set.ollama_help}" Style="{StaticResource Help}" />
                    <TextBlock Text="{l:T set.mirror}" Style="{StaticResource Field}" Margin="0,4,0,4" />
                    <DockPanel Margin="0,0,0,2">
                        <Button DockPanel.Dock="Right" Click="OnPickMirror" Margin="8,0,0,0" Padding="12,5" AutomationProperties.Name="{l:T set.pick}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Server}" Style="{StaticResource Ico}" Margin="0,0,6,0" />
                                <TextBlock Text="{l:T set.pick}" />
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="Mirror" AutomationProperties.Name="{l:T set.mirror}" />
                    </DockPanel>
                    <TextBlock Text="{l:T set.mirror_help}" Style="{StaticResource Caption}" Margin="0,0,0,12" />
                    <TextBlock Text="{l:T set.repos}" Style="{StaticResource Field}" />
                    <TextBox x:Name="Repos" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                             AutomationProperties.Name="{l:T set.repos}" />
                    <TextBlock Text="{l:T set.repos_help}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Startup and updates -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Style="{StaticResource Head}">
                        <Path Data="{StaticResource Icon.Power}" Style="{StaticResource Ico}" Margin="0,0,10,0" />
                        <TextBlock Text="{l:T set.startup_section}" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <CheckBox x:Name="Startup" Content="{l:T set.startup}" />
                    <TextBlock Text="{l:T set.startup_help}" Style="{StaticResource Help}" />
                    <CheckBox x:Name="Updates" Content="{l:T set.updates}" />
                    <TextBlock Text="{l:T set.updates_help}" Style="{StaticResource Help}" Margin="28,2,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,24">
                <Button Style="{StaticResource AccentButtonStyle}" Width="160" Click="OnSave" Padding="0,8" AutomationProperties.Name="{l:T set.save}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Check}" Style="{StaticResource Ico}" Margin="0,0,8,0" />
                        <TextBlock Text="{l:T set.save}" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="SavedText" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>

            <!-- Emergency exit -->
            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource WarningBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Background="{StaticResource WarningBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                        <Path Data="{StaticResource Icon.Warning}" Style="{StaticResource Ico}" Width="20" Height="20" Fill="White" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{l:T set.danger}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{l:T set.danger_help}" Style="{StaticResource Caption}" Margin="0,4,0,10" />
                        <Button HorizontalAlignment="Left" Click="OnRestoreAll" Padding="12,6" AutomationProperties.Name="{l:T set.restore_all}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.CloudDown}" Style="{StaticResource Ico}" Margin="0,0,8,0" />
                                <TextBlock Text="{l:T set.restore_all}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
            <TextBlock x:Name="AboutText" Style="{StaticResource Caption}" Margin="0,4,0,20" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
