<UserControl x:Class="Marea.App.Views.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Marea.App">
    <Grid Margin="0,0,8,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{l:T models.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T models.subtitle}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Toolbar: search, filter, totals -->
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Border x:Name="AttentionChip" DockPanel.Dock="Right" CornerRadius="14" Padding="12,5" VerticalAlignment="Center"
                    Background="{StaticResource WarningBrush}" Visibility="Collapsed" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.ShieldError}" Style="{StaticResource Ico}" Fill="White" Width="14" Height="14" Margin="0,0,6,0" />
                    <TextBlock x:Name="AttentionText" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="TotalText" DockPanel.Dock="Right" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" />
            <ComboBox x:Name="Filter" DockPanel.Dock="Right" Width="200" SelectionChanged="OnFilter" AutomationProperties.Name="{l:T models.filter}" />
            <Grid MinWidth="160" Margin="0,0,8,0">
                <TextBox x:Name="Search" Padding="30,6,8,6" TextChanged="OnSearch" VerticalContentAlignment="Center"
                         AutomationProperties.Name="{l:T models.search}" />
                <Path Data="{StaticResource Icon.Search}" Style="{StaticResource Ico}" Width="14" Height="14"
                      HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Opacity="0.7" />
                <TextBlock x:Name="SearchHint" Text="{l:T models.search}" Style="{StaticResource Caption}" FontSize="13"
                           Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
        </DockPanel>

        <Grid Grid.Row="2">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="48"
                      HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                      SelectionChanged="OnSelection" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{l:T col.model}" Width="*" MinWidth="280" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel VerticalAlignment="Center" Margin="6,0">
                                    <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Cube}" Style="{StaticResource Ico}" Fill="{Binding KindBrush}" Margin="0,0,10,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}" />
                                        <TextBlock Text="{Binding Kind}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Kind}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:T col.format}" Binding="{Binding Format}" Width="110" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:T col.precision}" Binding="{Binding Precision}" Width="112" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:T col.params}" Binding="{Binding Params}" Width="125" SortMemberPath="ParamCount" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:T col.size}" Binding="{Binding Size}" Width="85" SortMemberPath="Bytes" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:T col.state}" Binding="{Binding State}" Width="115" ElementStyle="{StaticResource CellText}" />
                    <DataGridTemplateColumn Header="{l:T col.safety}" Width="195" SortMemberPath="SafetyRank">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                    <Path Data="{Binding SafetyIcon}" Style="{StaticResource Ico}" Fill="{Binding SafetyBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Safety}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Text="{l:T models.empty}" Style="{StaticResource Caption}" FontSize="14" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="460" Visibility="Collapsed" />
        </Grid>

        <!-- Detail of the selected model -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
            <DockPanel>
                <Border x:Name="DetailBadge" DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Margin="0,0,14,0"
                        VerticalAlignment="Top" Background="{StaticResource SeaAccentBrush}">
                    <Path x:Name="DetailIcon" Data="{StaticResource Icon.Cube}" Style="{StaticResource Ico}" Width="20" Height="20" Fill="White" />
                </Border>
                <Button x:Name="OpenButton" DockPanel.Dock="Right" VerticalAlignment="Top" Click="OnOpenFolder" Padding="12,6"
                        IsEnabled="False" AutomationProperties.Name="{l:T models.open_folder}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Open}" Style="{StaticResource Ico}" Margin="0,0,6,0" />
                        <TextBlock Text="{l:T models.open_folder}" />
                    </StackPanel>
                </Button>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock x:Name="DetailTitle" Text="{l:T models.select_title}" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailText" Text="{l:T models.select_hint}" TextWrapping="Wrap" LineHeight="20" />
                    <TextBlock x:Name="DetailFiles" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
