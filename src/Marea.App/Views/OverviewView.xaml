<UserControl x:Class="Marea.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Marea.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{l:T ov.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T ov.subtitle}" Style="{StaticResource PageSubtitle}" />

            <Border x:Name="EmptyCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{l:T ov.empty_title}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{l:T ov.empty_text}" Style="{StaticResource Caption}" Margin="0,0,0,12" />
                    <Button Content="{l:T ov.add_folder}" HorizontalAlignment="Left" Click="OnAddFolder" />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="VolumesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding State}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0" />
                                </DockPanel>
                                <ProgressBar Height="8" Margin="0,10,0,6" Maximum="1" Value="{Binding Used, Mode=OneWay}" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <UniformGrid Columns="4" Margin="-6,0,-6,6">
                <Border Style="{StaticResource Card}" Margin="6,0,6,12">
                    <StackPanel>
                        <TextBlock Text="{l:T ov.allowed}" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="AllowedText" Style="{StaticResource BigNumber}" Foreground="{StaticResource DuplicateBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,6,12">
                    <StackPanel>
                        <TextBlock Text="{l:T ov.evaporated}" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="EvaporatedText" Style="{StaticResource BigNumber}" Foreground="{StaticResource EvaporatedBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,6,12">
                    <StackPanel>
                        <TextBlock Text="{l:T ov.unique}" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="UniqueText" Style="{StaticResource BigNumber}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,6,12">
                    <StackPanel>
                        <TextBlock Text="{l:T ov.total}" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="TotalText" Style="{StaticResource BigNumber}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{l:T ov.breakdown_title}" Style="{StaticResource SectionTitle}" />
                        <ItemsControl x:Name="ClassBars">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Height="10" CornerRadius="5" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <Border HorizontalAlignment="Left" CornerRadius="5" Background="{Binding Brush}" Width="{Binding BarWidth}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Size}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{l:T ov.breakdown_help}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="28,0,0,0" Width="230">
                        <Button x:Name="FreeButton" Style="{StaticResource AccentButtonStyle}" Content="{l:T ov.free}" Click="OnFree" HorizontalAlignment="Stretch" Margin="0,0,0,8" Padding="0,8" />
                        <Button Content="{l:T ov.scan}" Click="OnScan" HorizontalAlignment="Stretch" Padding="0,8" />
                        <TextBlock x:Name="LastScan" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:T ov.recent}" Style="{StaticResource SectionTitle}" />
                    <ItemsControl x:Name="Recent">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Caption}" />
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Action, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding What, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
