<UserControl x:Class="Marea.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Marea.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,0,8,12">
            <TextBlock Text="{l:T ov.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T ov.subtitle}" Style="{StaticResource PageSubtitle}" />

            <!-- Update available -->
            <Border x:Name="UpdateBar" Style="{StaticResource InfoBar}" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Click="OnOpenReleases" Padding="12,4" AutomationProperties.Name="{l:T upd.open}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Open}" Style="{StaticResource Ico}" Margin="0,0,6,0" />
                            <TextBlock Text="{l:T upd.open}" />
                        </StackPanel>
                    </Button>
                    <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Sparkle}" Style="{StaticResource Ico}" Fill="{StaticResource SeaAccentBrush}" Margin="0,0,10,0" />
                    <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- Empty state -->
            <Border x:Name="EmptyCard" Style="{StaticResource Card}" Visibility="Collapsed" Padding="28,24">
                <DockPanel>
                    <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/marea.png" Width="72" Height="72" Margin="0,0,24,0" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="{l:T ov.empty_title}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{l:T ov.empty_text}" Style="{StaticResource Caption}" FontSize="13" Margin="0,6,0,14" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource AccentButtonStyle}" Click="OnFindFolders" Padding="14,7" Margin="0,0,8,0" AutomationProperties.Name="{l:T folders.find}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.FolderSearch}" Style="{StaticResource Ico}" Margin="0,0,8,0" />
                                    <TextBlock Text="{l:T folders.find}" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnAddFolder" Padding="14,7" AutomationProperties.Name="{l:T ov.add_folder}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.FolderAdd}" Style="{StaticResource Ico}" Margin="0,0,8,0" />
                                    <TextBlock Text="{l:T ov.add_folder}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Hero: what you can free right now -->
            <Border x:Name="HeroCard" Style="{StaticResource Card}" Padding="26,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Shield}" Style="{StaticResource Ico}" Fill="{StaticResource DuplicateBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{l:T ov.allowed}" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="AllowedText" FontSize="46" FontWeight="SemiBold" Foreground="{StaticResource DuplicateBrush}" Margin="0,4,0,0" />
                        <TextBlock x:Name="AllowedDetail" Style="{StaticResource Caption}" FontSize="13" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="270">
                        <Button x:Name="QuickButton" Style="{StaticResource AccentButtonStyle}" Click="OnQuick" HorizontalAlignment="Stretch" Padding="0,11" Margin="0,0,0,8" AutomationProperties.Name="{l:T ov.quick}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Flash}" Style="{StaticResource Ico}" Margin="0,0,8,0" />
                                <TextBlock Text="{l:T ov.quick}" FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>
                        </Button>
                        <UniformGrid Columns="2">
                            <Button x:Name="FreeButton" Click="OnFree" Padding="0,7" Margin="0,0,4,0" ToolTip="{l:T ov.free}" HorizontalAlignment="Stretch" AutomationProperties.Name="{l:T ov.plan_short}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Broom}" Style="{StaticResource Ico}" Margin="0,0,6,0" />
                                    <TextBlock Text="{l:T ov.plan_short}" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnScan" Padding="0,7" Margin="4,0,0,0" ToolTip="{l:T ov.scan}" HorizontalAlignment="Stretch" AutomationProperties.Name="{l:T ov.scan_short}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Sync}" Style="{StaticResource Ico}" Margin="0,0,6,0" />
                                    <TextBlock Text="{l:T ov.scan_short}" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <TextBlock x:Name="LastScan" Style="{StaticResource Caption}" Margin="0,8,0,0" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Undo last cleanup -->
            <Border x:Name="UndoBar" Style="{StaticResource InfoBar}" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="UndoButton" DockPanel.Dock="Right" Click="OnUndo" Padding="12,4" AutomationProperties.Name="{l:T qf.undo}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Undo}" Style="{StaticResource Ico}" Margin="0,0,6,0" />
                            <TextBlock Text="{l:T qf.undo}" />
                        </StackPanel>
                    </Button>
                    <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Cloud}" Style="{StaticResource Ico}" Fill="{StaticResource EvaporatedBrush}" Margin="0,0,10,0" />
                    <TextBlock x:Name="UndoText" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- Drives -->
            <ItemsControl x:Name="VolumesList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" CornerRadius="10" Padding="10,3" Background="{Binding StateBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding State}" FontSize="12" Foreground="White" />
                                    </Border>
                                    <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Storage}" Style="{StaticResource IcoLarge}" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                                </DockPanel>
                                <ProgressBar Height="8" Margin="0,12,0,8" Maximum="1" Value="{Binding Used, Mode=OneWay}" Foreground="{StaticResource SeaAccentBrush}" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Stats -->
            <UniformGrid x:Name="StatsRow" Columns="3" Margin="-6,0,-6,6">
                <Border Style="{StaticResource Card}" Margin="6,0,6,12">
                    <DockPanel>
                        <Path DockPanel.Dock="Right" Data="{StaticResource Icon.Cloud}" Style="{StaticResource IcoLarge}" Fill="{StaticResource EvaporatedBrush}" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="{l:T ov.evaporated}" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="EvaporatedText" Style="{StaticResource BigNumber}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,6,12">
                    <DockPanel>
                        <Path DockPanel.Dock="Right" Data="{StaticResource Icon.Lock}" Style="{StaticResource IcoLarge}" Fill="{StaticResource UniqueBrush}" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="{l:T ov.unique}" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="UniqueText" Style="{StaticResource BigNumber}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,6,12">
                    <DockPanel>
                        <Path DockPanel.Dock="Right" Data="{StaticResource Icon.Library}" Style="{StaticResource IcoLarge}" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="{l:T ov.total}" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="TotalText" Style="{StaticResource BigNumber}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <!-- Where every byte would come back from -->
            <Border x:Name="BreakdownCard" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Path Data="{StaticResource Icon.DataPie}" Style="{StaticResource Ico}" Margin="0,0,8,0" />
                        <TextBlock Text="{l:T ov.breakdown_title}" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <Border x:Name="BarTrack" CornerRadius="7" Height="14" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            SizeChanged="OnBarSizeChanged">
                        <Grid x:Name="StackedBar" />
                    </Border>
                    <ItemsControl x:Name="Legend" Margin="0,14,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,5,20,5">
                                    <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16" Background="{Binding Brush}" Margin="0,0,12,0" VerticalAlignment="Top">
                                        <Path Data="{Binding Icon}" Style="{StaticResource Ico}" Fill="White" />
                                    </Border>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Help}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Recent activity -->
            <Border x:Name="RecentCard" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Path Data="{StaticResource Icon.History}" Style="{StaticResource Ico}" Margin="0,0,8,0" />
                        <TextBlock Text="{l:T ov.recent}" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <ItemsControl x:Name="Recent" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,5">
                                    <Path DockPanel.Dock="Left" Data="{Binding Icon}" Style="{StaticResource Ico}" Fill="{Binding Brush}" Margin="0,0,10,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                        <Run Text="{Binding Action, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding What, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
