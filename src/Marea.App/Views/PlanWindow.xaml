<Window x:Class="Marea.App.Views.PlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Marea.App"
        Title="{l:T plan.title}" Width="900" Height="600" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{l:T plan.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T plan.subtitle}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>
        <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:T col.name}" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="{l:T col.folder}" Binding="{Binding Folder}" Width="2*" />
                <DataGridTextColumn Header="{l:T col.size}" Binding="{Binding Size}" Width="120" />
                <DataGridTextColumn Header="{l:T col.class}" Binding="{Binding Class}" Width="110" />
                <DataGridTextColumn Header="{l:T col.return}" Binding="{Binding Return}" Width="100" />
                <DataGridTextColumn Header="{l:T col.source}" Binding="{Binding Source}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="TotalText" FontSize="16" FontWeight="SemiBold" />
            <CheckBox x:Name="Understand" Content="{l:T plan.understand}" Margin="0,10,0,0" Checked="OnUnderstand" Unchecked="OnUnderstand" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="{l:T op.cancel}" IsCancel="True" Width="120" Margin="0,0,10,0" />
                <Button x:Name="GoButton" Style="{StaticResource AccentButtonStyle}" Content="{l:T plan.go}" Width="160" IsEnabled="False" Click="OnGo" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
